# Optional LLM Extractor API Keys
# The default rule-based extractor operates offline without any API keys.
# Set one of the following to enable the LLM-assisted extractor:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Extractor engine: "rules" (default) or "llm"
EXTRACTOR_ENGINE=rules

# Public HAPI FHIR test server for validation
HAPI_FHIR_URL=https://hapi.fhir.org/baseR4
